# Copy to .env (git-ignored) and edit. Process env wins over .env.

# Server address
TT_HOST=127.0.0.1
TT_PORT=8000

# Route prefix for the API (/health is always unprefixed)
TT_API_PREFIX=/api/v0

# Simulated duration of each stub tool, seconds
TT_TOOL_DELAY_S=1.0

# Active (non-terminal) runs limit; above it POST /runs returns 429
TT_MAX_ACTIVE_RUNS=16

# Tools to report as down, comma-separated: schemathesis,microcks,mutation
TT_UNAVAILABLE_TOOLS=
