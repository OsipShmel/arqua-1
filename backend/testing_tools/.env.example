# Copy to .env (git-ignored) and edit. Process env wins over .env.

# Server address
TT_HOST=127.0.0.1
TT_PORT=8000

# Route prefix for the API (/health is always unprefixed)
TT_API_PREFIX=/api/v0

# real = run the tools; stub = fake results derived from the contract (no tools needed)
TT_TOOL_MODE=real

# Simulated duration of each stub tool, seconds (stub mode only)
TT_TOOL_DELAY_S=1.0

# Active (non-terminal) runs limit; above it POST /runs returns 429
TT_MAX_ACTIVE_RUNS=16

# Tools to report as down, comma-separated: schemathesis,microcks,mutation
TT_UNAVAILABLE_TOOLS=

# Parent directory for per-tool scratch dirs; empty = system temp dir
TT_WORK_DIR=
# Keep scratch dirs after a tool finishes (debugging)
TT_KEEP_WORK_DIRS=false

# Microcks base URL, e.g. http://microcks:8080; empty = Microcks is unavailable
TT_MICROCKS_URL=
# Keycloak service account (client credentials) if Microcks has auth enabled
TT_MICROCKS_CLIENT_ID=
TT_MICROCKS_CLIENT_SECRET=
# How often to poll a running Microcks test, seconds
TT_MICROCKS_POLL_INTERVAL_S=1.0

# uv executable, used to build a venv for mutation test suites with `requirements`
TT_UV_BIN=uv
